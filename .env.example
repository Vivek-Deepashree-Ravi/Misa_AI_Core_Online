GEMINI_API_KEY=your-gemini-api-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional Angel One SmartAPI snapshots. PIN/TOTP are entered in the login CLI only.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_CLIENT_PUBLIC_IP=
ANGEL_CLIENT_LOCAL_IP=127.0.0.1

# Host audio hardware normally runs at 48 kHz. Misa resamples to/from the
# 16 kHz input and 24 kHz output required by Gemini Live.
MISA_INPUT_DEVICE_RATE=48000
MISA_OUTPUT_DEVICE_RATE=48000
MISA_INPUT_DEVICE=pulse
MISA_OUTPUT_DEVICE=pulse

# Optional: enables Instagram/TikTok analytics through Zernio.
ZERNIO_API_KEY=your-zernio-api-key

# Optional: enables Home Assistant smart-home controls.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your-home-assistant-long-lived-access-token
